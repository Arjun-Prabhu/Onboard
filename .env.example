# Onboard server settings. Copy to .env (optional; these are the defaults).
PORT=3000
DATABASE_PATH=./data/onboard.db
# Set to "true" to allow POST /api/meta/reset-demo (restores the demo data).
DEMO_MODE=true
# AG Grid / AG Charts Enterprise license key (optional). Without it the Volunteers grid shows an
# evaluation watermark. Read by the UI at build/dev time, so restart `npm run dev` after setting it.
VITE_AG_GRID_LICENSE_KEY=
