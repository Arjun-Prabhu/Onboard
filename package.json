{
  "name": "onboard",
  "private": true,
  "version": "0.1.0",
  "description": "Onboard — local web app for volunteer management at Robolution CLT (FBLA Coding & Programming 2026–27)",
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate && concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --tsconfig tsconfig.server.json server/index.ts",
    "dev:web": "vite --open",
    "build": "tsc -b && vite build",
    "start": "npm run db:migrate && tsx --tsconfig tsconfig.server.json server/index.ts --production",
    "demo": "npm run build && npm start",
    "db:emit": "prisma contract emit",
    "db:plan": "prisma migration plan",
    "db:migrate": "prisma db migrate",
    "db:seed": "tsx --tsconfig tsconfig.server.json server/prisma/seed.ts",
    "db:fresh": "node -e \"require('fs').rmSync('data',{recursive:true,force:true})\" && npm run db:migrate && npm run db:seed",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@prisma/orm-sqlite": "8.0.0-rc.24",
    "ag-charts-community": "14.3.0",
    "ag-charts-enterprise": "14.3.0",
    "ag-grid-community": "36.3.0",
    "ag-grid-enterprise": "36.3.0",
    "ag-grid-react": "36.3.0",
    "bcrypt": "6.0.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "fuse.js": "^7.5.0",
    "helmet": "8.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "prisma": "8.0.0-rc.34",
    "supertest": "7.3.2",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.5"
  }
}
