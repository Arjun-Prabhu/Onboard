// use prisma-8

// Onboard data contract (Prisma ORM 8) — §2.5 of the requirements doc.
//
// Identity is separated from organization and from volunteering:
//   User            one login per person, no role
//   Membership      management rights in ONE org (Owner / Admin / Coordinator)
//   OrgVolunteer    volunteer standing in ONE org (pipeline + requirements checklist)
//   VolunteerProfile reusable attributes (skills, availability), once per person
//   SignUp, HourLog attach to the person, so they can serve any org's sessions
//
// Ids are generated by the server (readable prefixes such as `usr_…`). Calendar dates are
// `YYYY-MM-DD` text, times of day `HH:mm` text and instants ISO-8601 text, matching the JSON
// the API sends, so no value changes shape between the database and the browser.
// SQLite has no boolean column in Prisma 8, so flags are `Int` 0/1; the repositories convert.

enum OrgRole {
  OWNER
  ADMIN
  COORDINATOR
}

enum VolunteerStatus {
  APPLIED
  INTERVIEWED
  TRAINED
  ACTIVE
  INACTIVE
}

enum ExperienceLevel {
  NEW
  INTERMEDIATE
  VETERAN
}

enum OrgSector {
  STEM
  HEALTH
  SPORTS
  COMMUNITY
  OTHER
}

// What a site's served range counts: school grades, ages, or nothing.
enum RangeKind {
  GRADE
  AGE
  NONE
}

enum ProgramType {
  ONGOING
  SEASONAL
}

enum SessionType {
  SHIFT
  EVENT
  TRAINING
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum SignUpStatus {
  SIGNED_UP
  WAITLISTED
  CHECKED_IN
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum HourStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EquipmentCondition {
  GOOD
  NEEDS_REPAIR
  MISSING_PARTS
  RETIRED
}

// Settings live on the org row: its sector, the words it uses, its served-range kind and its
// feature toggles. The skill catalog and event roles are child tables.
model Organization {
  id               String         @id
  name             String         @unique
  description      String
  timezone         String
  createdAt        String
  sector           OrgSector
  siteTerm         String
  participantTerm  String
  equipmentTerm    String
  priorityLabel    String
  rangeKind        RangeKind
  featureEquipment Int
  featurePriority  Int
  featureGuests    Int
  memberships      Membership[]
  orgVolunteers    OrgVolunteer[]
  sites            Site[]
  equipment        Equipment[]
  hourLogs         HourLog[]
  skills           OrgSkill[]
  eventRoles       OrgEventRole[]
  requirements     Requirement[]
}

// The org's own skill catalog, in display order.
model OrgSkill {
  orgId       String
  skillId     String
  position    Int
  // Optional one-line explanation shown wherever volunteers or organizers pick skills.
  description String?
  org         Organization @relation(fields: [orgId], references: [id])
  skill       Skill        @relation(fields: [skillId], references: [id])

  @@id([orgId, skillId])
}

// Role names offered on the org's events, in display order.
model OrgEventRole {
  id       String       @id
  orgId    String
  name     String
  position Int
  org      Organization @relation(fields: [orgId], references: [id])
}

// Something a volunteer must complete before serving shifts and events (training, a
// background check, a TB test…). `validMonths` null = never expires. Archived, never deleted.
model Requirement {
  id          String                 @id
  orgId       String
  name        String
  description String
  validMonths Int?
  position    Int
  archived    Int
  org         Organization           @relation(fields: [orgId], references: [id])
  completions VolunteerRequirement[]
}

// One volunteer's completion of one requirement.
model VolunteerRequirement {
  orgVolunteerId String
  requirementId  String
  completedAt    String
  expiresAt      String?
  recordedBy     String
  orgVolunteer   OrgVolunteer @relation(fields: [orgVolunteerId], references: [id])
  requirement    Requirement  @relation(fields: [requirementId], references: [id])

  @@id([orgVolunteerId, requirementId])
}

model User {
  id            String            @id
  firstName     String
  lastName      String
  email         String            @unique
  phone         String?
  zip           String?
  passwordHash  String
  tourCompleted Int
  createdAt     String
  profile       VolunteerProfile?
  memberships   Membership[]
  orgVolunteers OrgVolunteer[]
  signUps       SignUp[]
  hourLogs      HourLog[]
  presets       FilterPreset[]
  authSessions  AuthSession[]
}

model Membership {
  id        String       @id
  orgId     String
  userId    String
  orgRole   OrgRole
  createdAt String
  org       Organization @relation(fields: [orgId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
}

model VolunteerProfile {
  id                String           @id
  userId            String           @unique
  affiliation       String
  experienceLevel   ExperienceLevel
  hasTransportation Int
  bio               String?
  user              User             @relation(fields: [userId], references: [id])
  skills            VolunteerSkill[]
  availability      Availability[]
}

model Skill {
  id              String           @id
  name            String           @unique
  volunteerSkills VolunteerSkill[]
  sessionSkills   SessionSkill[]
  orgSkills       OrgSkill[]
}

// Skills belong to the person (composite key: one row per profile + skill).
model VolunteerSkill {
  profileId String
  skillId   String
  profile   VolunteerProfile @relation(fields: [profileId], references: [id])
  skill     Skill            @relation(fields: [skillId], references: [id])

  @@id([profileId, skillId])
}

model Availability {
  id        String           @id
  profileId String
  dayOfWeek Int
  startTime String
  endTime   String
  profile   VolunteerProfile @relation(fields: [profileId], references: [id])
}

model OrgVolunteer {
  id            String                 @id
  orgId         String
  userId        String
  status        VolunteerStatus
  createdAt     String
  org           Organization           @relation(fields: [orgId], references: [id])
  user          User                   @relation(fields: [userId], references: [id])
  statusHistory StatusChange[]
  requirements  VolunteerRequirement[]

  @@unique([orgId, userId])
}

model StatusChange {
  id             String           @id
  orgVolunteerId String
  fromStatus     VolunteerStatus?
  toStatus       VolunteerStatus
  changedBy      String
  changedAt      String
  note           String?
  orgVolunteer   OrgVolunteer     @relation(fields: [orgVolunteerId], references: [id])
}

// A place where the org serves: a school, clinic, field, food pantry…
model Site {
  id           String       @id
  orgId        String
  name         String
  address      String
  zip          String
  priority     Int
  rangeMin     Int?
  rangeMax     Int?
  contactName  String
  contactEmail String
  archived     Int
  org          Organization @relation(fields: [orgId], references: [id])
  programs     Program[]

  @@unique([orgId, name])
}

model Program {
  id               String      @id
  siteId           String
  name             String
  type             ProgramType
  startDate        String
  endDate          String
  participantCount Int
  // Participants per volunteer, e.g. 6 means 1 volunteer : 6 participants. Null = no ratio.
  targetRatio      Int?
  description      String
  archived         Int
  // 1 = the hidden "One-time events" program that holds a site's one-off sessions.
  oneOff           Int
  site             Site        @relation(fields: [siteId], references: [id])
  sessions         Session[]
  equipment        Equipment[]
}

model Session {
  id               String         @id
  programId        String
  type             SessionType
  date             String
  startTime        String
  endTime          String
  title            String
  volunteersNeeded Int
  status           SessionStatus
  // One-time guest volunteers may join without standing in the org (FR-3d).
  openToGuests     Int
  program          Program        @relation(fields: [programId], references: [id])
  requiredSkills   SessionSkill[]
  roleSlots        RoleSlot[]
  signUps          SignUp[]
  hourLogs         HourLog[]
}

model SessionSkill {
  sessionId String
  skillId   String
  session   Session @relation(fields: [sessionId], references: [id])
  skill     Skill   @relation(fields: [skillId], references: [id])

  @@id([sessionId, skillId])
}

// Event role slots (FR-12). `role` holds one of the org's event role names, e.g. "Referee".
model RoleSlot {
  id        String  @id
  sessionId String
  role      String
  needed    Int
  position  Int
  session   Session @relation(fields: [sessionId], references: [id])
}

model SignUp {
  id               String       @id
  sessionId        String
  userId           String
  role             String
  status           SignUpStatus
  guest            Int
  waitlistPosition Int?
  checkInAt        String?
  checkOutAt       String?
  createdAt        String
  session          Session      @relation(fields: [sessionId], references: [id])
  user             User         @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
}

model HourLog {
  id            String       @id
  userId        String
  orgId         String
  sessionId     String?
  date          String
  hours         Float
  description   String
  status        HourStatus
  autoGenerated Int
  reviewedBy    String?
  reviewNote    String?
  user          User         @relation(fields: [userId], references: [id])
  org           Organization @relation(fields: [orgId], references: [id])
  session       Session?     @relation(fields: [sessionId], references: [id])
}

// A trackable item the org lends to programs: a robot kit, a blood-pressure cuff, a ball bag…
model Equipment {
  id           String             @id
  orgId        String
  assetTag     String
  name         String
  condition    EquipmentCondition
  programId    String?
  checkedOutAt String?
  org          Organization       @relation(fields: [orgId], references: [id])
  program      Program?           @relation(fields: [programId], references: [id])

  @@unique([orgId, assetTag])
}

// Saved smart-filter presets (FR-25). `filters` is the JSON of SessionFilters.
model FilterPreset {
  id      String @id
  userId  String
  name    String
  filters String
  user    User   @relation(fields: [userId], references: [id])
}

// Login sessions behind the httpOnly cookie. Only a SHA-256 hash of the token is stored.
// A sign-in. It ends after `sessionIdleHours` without activity (`expiresAt` slides forward as the
// person works) and never lasts past `sessionMaxDays` from `createdAt`.
model AuthSession {
  id         String @id
  tokenHash  String @unique
  userId     String
  createdAt  String
  expiresAt  String
  lastSeenAt String
  user       User   @relation(fields: [userId], references: [id])
}

// An offer to make someone an Owner (FR-3f). Nothing changes until the person offered accepts.
// `stepDown` = 1 when the person offering steps down at that moment (a hand-over).
// `status` is PENDING or DECLINED; accepted and cancelled offers are deleted. Offers older than
// 14 days are treated as expired. Like `StatusChange.changedBy`, the people are plain ids.
model OwnershipOffer {
  id         String @id
  orgId      String
  fromUserId String
  toUserId   String
  stepDown   Int
  status     String
  createdAt  String
}
